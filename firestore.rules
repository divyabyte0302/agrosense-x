rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check Admin custom claim or role
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true || 
        request.auth.token.role == 'ADMIN' ||
        request.auth.uid == 'admin_master_0'
      );
    }
    
    // Helper function to check Researcher custom claim or role
    function isResearcher() {
      return isAuthenticated() && (
        request.auth.token.researcher == true || 
        request.auth.token.role == 'RESEARCHER' ||
        request.auth.token.role == 'ADMIN' ||
        request.auth.uid == 'researcher_1'
      );
    }

    // Users collection: Users can read/write their own profile; Admins can read/write all
    match /Users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Plants collection: Strict per-user isolation
    match /Plants/{plantId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin() || isResearcher());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // SensorData collection: Telemetry data
    match /SensorData/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || request.auth.uid != null;
    }

    // Predictions collection: AI scan predictions
    match /Predictions/{predId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin() || isResearcher());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // HealthHistory collection
    match /HealthHistory/{histId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Alerts collection
    match /Alerts/{alertId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() || isAdmin();
    }

    // Feedback collection (Anonymized research feedback)
    match /Feedback/{feedbackId} {
      allow read: if isAuthenticated() && (isResearcher() || isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
